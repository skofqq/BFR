<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:id="@+id/widget_power"
        android:layout_width="42dp"
        android:layout_height="42dp">

        <ImageView
            android:id="@+id/widget_power_on"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_circle_on"
            android:contentDescription="@string/action_stop"
            android:padding="10dp"
            android:src="@drawable/ic_power"
            android:tint="@color/widget_green"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_power_off"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_circle_off"
            android:contentDescription="@string/action_start"
            android:padding="10dp"
            android:src="@drawable/ic_power"
            android:tint="@color/widget_red" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_status_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="clash"
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
