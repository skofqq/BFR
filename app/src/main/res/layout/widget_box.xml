<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_icon_bg">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_tile"
            android:tint="@color/widget_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_status_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="clash · tproxy"
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_restart"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_circle_neutral"
        android:contentDescription="@string/action_restart"
        android:padding="10dp"
        android:src="@drawable/ic_refresh"
        android:tint="@color/widget_text"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_stop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_circle_off"
        android:contentDescription="@string/action_stop"
        android:padding="10dp"
        android:src="@drawable/ic_power"
        android:tint="@color/widget_red"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_start"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_circle_on"
        android:contentDescription="@string/action_start"
        android:padding="10dp"
        android:src="@drawable/ic_power"
        android:tint="@color/widget_green" />
</LinearLayout>
